//   Build jobs: 1
//   Verilate jobs: 1

`begin_keywords "1800-2017"
`timescale 1ns/10ps
`timescale 1ns/10ps
package rx_pkg;
    parameter FPGA_MAC = 48'h123456;  
    parameter NASDAQ_MAC = 48'h65431;  
    parameter IP_TYPE = 16'h0800;  
    parameter IP_VERSION = 4'h4;  
    parameter IP_HDL = 4'h5;  
    parameter UDP_PROTOCOL = 8'h11; 
    parameter TCP_PROTOCOL = 8'h06; 
    parameter ICMP_PROTOCOL = 8'h01;
    parameter IP_TTL = 8'h40; 
    parameter IP_SRC_ADDR = 32'hFFFFFFFF;  
    parameter IP_DEST_ADDR = 32'hAAAAAAAA; 
    parameter UDP_SRC_ADDR = 16'h1234; 
    parameter UDP_DEST_ADDR = 16'h4321; 
    parameter UDP_HEADER_LENGTH = 16'h08;
    parameter UDP_CHECKSUM = 16'h0000;  
    typedef enum logic [3:0] { 
        IDLE,
        RCV_VER_IHL_DSCP_ECN,  
        RCV_LENGTH_IDEN_FLAGS_FRGOFF_TLL_PROTOCOL,  
        RCV_SUM_SRC_ADDR_DEST_ADDR,  
        RCV_PAYLOAD_DEST,  
        CHK_SUM,
        RCV_PAYLOAD,
        DONE,
        ERROR
    } IP_t;
    typedef enum logic [2:0] { 
        UDP_IDLE,
        UDP_HEADER,  
        UDP_CHK_SUM_PAYLOAD,  
        UDP_PAYLOAD,
        UDP_DONE,
        UDP_CHK_SUM,
        UDP_ERROR
    } UDP_t;
endpackage
module UDP_tx(
    input logic CLK, nRST,
    input logic UDP_valid,  
    input logic [63:0] UDP_payload,  
    input logic [15:0] UDP_len,  
    input logic [15:0] UDP_src_port, 
    input logic [15:0] UDP_dest_port, 
    input logic UDP_last,  
    output logic [63:0] IP_payload,  
    output logic IP_valid,  
    output logic IP_last
);
    import rx_pkg::*;
    typedef enum logic [1:0] {
        IDLE,
        SEND_HEADER,
        SEND_PAYLOAD,
        DONE
    } UDP_tx_t;
    UDP_tx_t current_state, nstate;
    logic [15:0] computed_len; 
    logic [63:0] header_reg;
    always_ff @(posedge CLK, negedge nRST) begin
        if (!nRST) begin
            current_state <= IDLE;
            header_reg <= '0;
        end else begin
            current_state <= nstate;
            header_reg <= {IP_DEST_ADDR[15:0], UDP_src_port, UDP_dest_port, computed_len};
        end
    end
    assign computed_len = UDP_len + UDP_HEADER_LENGTH; 
    always_comb begin
        nstate = current_state;
        IP_valid = 1'b0;
        IP_payload = '0; 
        casez(current_state)
            IDLE: begin
                if (UDP_valid) begin
                    IP_valid = 1'b1; 
                    nstate = SEND_HEADER;
                end
            end
            SEND_HEADER: begin
                nstate = SEND_PAYLOAD;
                IP_valid = 1'b1;
                IP_payload = header_reg;
            end
            SEND_PAYLOAD: begin
                IP_valid = 1'b1;
                IP_payload = UDP_payload;
                if (UDP_last) begin
                    nstate = DONE;
                end else if (~UDP_valid) begin
                    nstate = IDLE;
                end
            end
            DONE: begin
                IP_last = 1'b1;  
                nstate = IDLE;  
            end
            default: begin
                nstate = IDLE;  
            end
        endcase
    end
endmodule
