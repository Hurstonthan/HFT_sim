//
// Information:
//   Verilator 5.020 2024-01-01 rev (Debian 5.020-1)
//   Arguments: -Wno-lint --error-limit 0 --trace --trace-fst --debug -Iinclude -Irtl -CFLAGS -Irtl -Iinclude -O0 -g --cc rtl/UDP_rx.sv --top-module UDP_rx --exe generated/UDP_rx/UDP_rx_tb.cpp generated/UDP_rx/UDP_rx_input.cpp --build
//   Build jobs: 1
//   Verilate jobs: 1

`begin_keywords "1800-2017"
`timescale 1ns/10ps
`timescale 1ns/10ps
package rx_pkg;
    parameter FPGA_MAC = 48'h123456;  
    parameter NASDAQ_MAC = 48'h65431;  
    parameter IP_TYPE = 16'h0800;  
    parameter IP_VERSION = 4'h4;  
    parameter IP_HDL = 4'h5;  
    parameter UDP_PROTOCOL = 8'h11; 
    parameter TCP_PROTOCOL = 8'h06; 
    parameter ICMP_PROTOCOL = 8'h01;
    parameter IP_TTL = 8'h40; 
    parameter IP_SRC_ADDR = 32'hFFFFFFFF;  
    parameter IP_DEST_ADDR = 32'hAAAAAAAA; 
    parameter UDP_SRC_ADDR = 16'h1234; 
    parameter UDP_DEST_ADDR = 16'h4321; 
    parameter UDP_HEADER_LENGTH = 16'h08;
    parameter UDP_CHECKSUM = 16'h0000;  
    typedef enum logic [3:0] { 
        IDLE,
        RCV_VER_IHL_DSCP_ECN,  
        RCV_LENGTH_IDEN_FLAGS_FRGOFF_TLL_PROTOCOL,  
        RCV_SUM_SRC_ADDR_DEST_ADDR,  
        RCV_PAYLOAD_DEST,  
        CHK_SUM,
        RCV_PAYLOAD,
        DONE,
        ERROR
    } IP_t;
    typedef enum logic [2:0] { 
        UDP_IDLE,
        UDP_HEADER,  
        UDP_CHK_SUM_PAYLOAD,  
        UDP_PAYLOAD,
        UDP_DONE,
        UDP_CHK_SUM,
        UDP_ERROR
    } UDP_t;
endpackage
module UDP_rx (
    input logic CLK, nRST,
    input logic IP_valid,
    input logic IP_flush,
    input logic [63:0] IP_payload,
    input logic is_udp,
    output logic UDP_flush,
    output logic UDP_valid,
    output logic [63:0] UDP_payload 
);
    import rx_pkg::*;
    logic [15:0] cnt, next_cnt, UDP_len, next_UDP_len;
    UDP_t current_state, nstate;
    logic next_UDP_valid;
    logic [63:0] next_UDP_payload;
    always_ff @(posedge CLK, negedge nRST) begin
        if (!nRST) begin
            current_state <= UDP_IDLE;
            UDP_valid <= '0;
            UDP_payload <= '0;
            UDP_len <= '0;
            cnt <= '0;
        end else if (UDP_flush || IP_flush) begin
            current_state <= UDP_IDLE;
            UDP_valid <= '0;
            UDP_payload <= '0;
            UDP_len <= '0;
            cnt <= '0;
        end else begin
            current_state <= nstate;
            UDP_valid <= next_UDP_valid;
            UDP_payload <= next_UDP_payload;
            cnt <= next_cnt;
            UDP_len <= next_UDP_len;
        end
    end
    logic is_udp_source, is_udp_dest; 
    assign is_udp_source = (IP_payload[47:32] == UDP_SRC_ADDR);
    assign is_udp_dest = (IP_payload[31:16] == UDP_DEST_ADDR);
    always_comb begin
        nstate = current_state;
        next_UDP_valid = '0; 
        UDP_flush = '0;
        next_cnt = cnt;
        next_UDP_len = UDP_len; 
        casez(current_state) 
            UDP_IDLE: begin
                if (IP_valid && is_udp) begin
                    nstate = UDP_HEADER;
                end
            end
            UDP_HEADER: begin
                nstate = (IP_valid && is_udp_source && is_udp_dest)? UDP_CHK_SUM_PAYLOAD : UDP_ERROR;
                if (IP_valid && is_udp_dest && is_udp_source) begin
                        next_UDP_len = IP_payload[15:0]; 
                        next_UDP_valid = 1'b1;
                        next_cnt = 16'd6;  
                end
            end
            UDP_CHK_SUM_PAYLOAD: begin
                if(IP_valid) begin
                    next_UDP_payload = {16'b0, IP_payload[47:0]};
                    nstate = UDP_PAYLOAD;  
                    next_cnt = cnt + 16'd8; 
                    next_UDP_valid = 1'b1;
                end  
            end
            UDP_PAYLOAD: begin 
                if (IP_valid) begin
                    next_cnt = cnt + 16'd8;  
                    next_UDP_payload = IP_payload;
                    if (cnt >= UDP_len) begin 
                        nstate = UDP_DONE; 
                    end else begin
                        next_UDP_valid = 1'b1;
                    end
                end
            end
            UDP_DONE: begin
                nstate = UDP_IDLE; 
                next_UDP_len = '0;
                next_cnt = '0;
            end
            UDP_ERROR: begin
                UDP_flush = 1'b1;
                if (!IP_valid) begin
                    nstate = UDP_IDLE;
                end
            end
            default: nstate = current_state; 
        endcase 
    end
endmodule
