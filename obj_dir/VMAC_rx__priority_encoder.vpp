`begin_keywords "1800-2017"
`line 1 "rtl/priority_encoder.sv" 1
 
`timescale 1ns / 10ps
module priority_encoder #(
    parameter int WIDTH = 128,
    parameter logic MSB = 0,
    parameter int IDW   = $clog2(WIDTH)
) (
    input  logic [WIDTH-1:0] din,
    output logic             valid,
    output logic [IDW-1:0]   idx
);
    always_comb begin
        valid = 1'b0;
        idx   = '0;
         
        if (MSB) begin
            for (int i = 0; i < WIDTH; i++) begin
                if (din[(WIDTH - 1) - i] && !valid) begin
                    valid = 1'b1;
                    idx   = (WIDTH - 1)- i[IDW-1:0];
                end
            end

`line 24 "rtl/priority_encoder.sv" 0
        end else begin
            for (int i = 0; i < WIDTH; i++) begin
                if (din[i] && !valid) begin
                    valid = 1'b1;
                    idx   = i[IDW-1:0];
                end
            end
        end

`line 33 "rtl/priority_encoder.sv" 0
    end
endmodule

