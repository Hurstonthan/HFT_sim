    always_ff @(posedge CLK, negedge nRST) begin
        if (!nRST) begin
            current_state <= UDP_IDLE;
            UDP_valid <= '0;
            UDP_payload <= '0;
            UDP_len <= '0;
            cnt <= '0;
        end else if (UDP_flush || IP_flush) begin
            current_state <= UDP_IDLE;
            UDP_valid <= '0;
            UDP_payload <= '0;
            UDP_len <= '0;
            cnt <= '0;
        end else begin
            current_state <= nstate;
            UDP_valid <= next_UDP_valid;
            UDP_payload <= next_UDP_payload;
            cnt <= next_cnt;
            UDP_len <= next_UDP_len;
        end
    end

