            IP_send <= 0;
        end else begin
            IP_send <= IP_send_l;
        end
    end

`line 94 "rtl/MAC_tx.sv" 0
    always_comb begin  
        nstate = state;
        IP_send_l = IP_send;
        crc_init = 1'b0;
        valid = 1'b1;
        frame_end = 1'b0;
        case (state)
