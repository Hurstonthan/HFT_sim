`line 67 "rtl/MAC_tx.sv" 0
    always_ff @(posedge CLK, negedge nRST) begin  
        if (!nRST) begin
            state <= IDLE;
            xgmii_txd_l <= 64'h07070707_07070707;
            xgmii_txc_l <= '1;
            len_counter <= 0;
            IP_last_dl <= 0;
             
        end else begin
            state <= nstate;
            xgmii_txd_l <= nxgmii_txd_l;
            xgmii_txc_l <= nxgmii_txc_l;
            len_counter <= nlen_counter;
            IP_last_dl <= IP_last;
             
            
        end
    end

`line 86 "rtl/MAC_tx.sv" 0
    always_ff @(posedge CLK, negedge nRST) begin 
